# ============================================================
# KEY FREE cho LiteLLM — copy file này thành `keys.env` rồi điền.
# keys.env đã .gitignore — KHÔNG commit. Mỗi key lấy MIỄN PHÍ, không thẻ.
# Để TRỐNG cái nào chưa có cũng được — LiteLLM bỏ qua, dùng cái còn lại.
# ============================================================

# --- SMART (việc khó) ---
# GitHub Models: https://github.com/marketplace/models  (dùng GitHub PAT, scope models)
GITHUB_API_KEY=
# Gemini Pro (acc đặc biệt của Sếp): https://aistudio.google.com/apikey
GEMINI_PRO_KEY=

# --- FAST (việc thường) ---
# Cerebras: https://cloud.cerebras.ai/   (cực nhanh, 14.4k req/ngày)
CEREBRAS_API_KEY=
# (Groq đã gỡ khỏi router: tài khoản Google bị hạn chế, không tạo được key.
#  Tầng fast vẫn còn NVIDIA + Mistral + Cohere + Cerebras + OpenRouter thay phiên.)

# --- BULK (6 acc Google = 6× quota Gemini Flash) ---
# Mỗi tài khoản Google -> 1 key riêng ở https://aistudio.google.com/apikey
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=
GEMINI_KEY_5=
GEMINI_KEY_6=
