{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/schemas/coding-arena-v2.json",
  "title": "AURA Coding Arena evidence record",
  "oneOf": [
    {"$ref": "#/$defs/pre_registration"},
    {"$ref": "#/$defs/task"},
    {"$ref": "#/$defs/episode"},
    {"$ref": "#/$defs/result"},
    {"$ref": "#/$defs/lesson"},
    {"$ref": "#/$defs/approval"},
    {"$ref": "#/$defs/promotion"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "pre_registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "batch_id", "n_tasks", "threshold_p", "hypothesis_direction", "registered_at", "manifest_sha", "registration_signature"],
      "properties": {
        "record_type": {"const": "pre_registration"},
        "batch_id": {"type": "string", "minLength": 1},
        "n_tasks": {"type": "integer", "minimum": 1},
        "threshold_p": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.05},
        "hypothesis_direction": {"const": "aura_better"},
        "registered_at": {"type": "string", "format": "date-time"},
        "manifest_sha": {"$ref": "#/$defs/sha256"},
        "registration_signature": {"$ref": "#/$defs/sha256"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "id", "batch_id", "repo_hash", "task_manifest_sha", "failing_test", "files_allowed", "forbidden_paths", "budget_s", "requested_max_output_tokens", "budget_prompt_chars", "budget_reply_chars", "network"],
      "properties": {
        "record_type": {"const": "task"},
        "id": {"type": "string", "minLength": 1},
        "batch_id": {"type": "string", "minLength": 1},
        "repo_hash": {"$ref": "#/$defs/sha256"},
        "task_manifest_sha": {"$ref": "#/$defs/sha256"},
        "failing_test": {"type": "string", "minLength": 1},
        "files_allowed": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "forbidden_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "budget_s": {"type": "integer", "minimum": 1},
        "requested_max_output_tokens": {"type": "integer", "minimum": 1},
        "budget_prompt_chars": {"type": "integer", "minimum": 1},
        "budget_reply_chars": {"type": "integer", "minimum": 1},
        "network": {"const": false}
      }
    },
    "model_call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_sha", "reply_sha", "declared_history_free", "declared_tools_enabled", "declared_recall_enabled"],
      "properties": {
        "prompt_sha": {"$ref": "#/$defs/sha256"},
        "reply_sha": {"$ref": "#/$defs/sha256"},
        "declared_history_free": {"type": "boolean"},
        "declared_tools_enabled": {"type": "boolean"},
        "declared_recall_enabled": {"type": "boolean"}
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "task_id", "run_id", "run_kind", "actor", "declared_model_id", "model_calls", "prompt_sha", "patch_sha", "stdout_sha", "stderr_sha", "tests_before", "tests_after", "elapsed_s_measured_by_evaluator", "tokens_reported_by_participant", "prompt_chars_measured_by_evaluator", "reply_chars_measured_by_evaluator", "reply_char_limit", "attempts", "human_touches", "exit_reason", "episode_signature"],
      "properties": {
        "record_type": {"const": "episode"},
        "task_id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "run_kind": {"enum": ["arena", "reproduction"]},
        "actor": {"enum": ["aura", "baseline"]},
        "declared_model_id": {"type": "string", "minLength": 1},
        "model_calls": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/model_call"}},
        "prompt_sha": {"$ref": "#/$defs/sha256"},
        "patch_sha": {"$ref": "#/$defs/sha256"},
        "stdout_sha": {"$ref": "#/$defs/sha256"},
        "stderr_sha": {"$ref": "#/$defs/sha256"},
        "tests_before": {"type": "object"},
        "tests_after": {"type": "object"},
        "elapsed_s_measured_by_evaluator": {"type": "number", "minimum": 0},
        "tokens_reported_by_participant": {"type": "integer", "minimum": 0},
        "prompt_chars_measured_by_evaluator": {"type": "integer", "minimum": 0},
        "reply_chars_measured_by_evaluator": {"type": "integer", "minimum": 0},
        "reply_char_limit": {"type": "integer", "minimum": 1},
        "attempts": {"type": "integer", "minimum": 1},
        "human_touches": {"type": "integer", "minimum": 0},
        "exit_reason": {"type": "string", "minLength": 1},
        "episode_signature": {"$ref": "#/$defs/sha256"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "task_id", "run_id", "evaluator_version", "environment_fingerprint", "hidden_pass", "hidden_total", "red_test_pass", "regression_pass", "safety_flags", "result_signature"],
      "properties": {
        "record_type": {"const": "result"},
        "task_id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "evaluator_version": {"type": "string", "minLength": 1},
        "environment_fingerprint": {"$ref": "#/$defs/sha256"},
        "hidden_pass": {"type": "integer", "minimum": 0},
        "hidden_total": {"type": "integer", "minimum": 1},
        "red_test_pass": {"type": "boolean"},
        "regression_pass": {"type": ["boolean", "null"]},
        "safety_flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "result_signature": {"$ref": "#/$defs/sha256"}
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "id", "failure_signature", "content", "evidence_run_ids", "evidence_patch_sha", "held_out_run_ids", "status"],
      "properties": {
        "record_type": {"const": "lesson"},
        "id": {"type": "string", "minLength": 1},
        "failure_signature": {"$ref": "#/$defs/sha256"},
        "content": {"type": "string", "minLength": 1},
        "evidence_run_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "evidence_patch_sha": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
        "held_out_run_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "status": {"enum": ["candidate", "rejected", "promoted"]}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "id", "champion_before", "candidate", "vibe_diff_sha", "decision", "approved_by", "approved_at", "channel", "telegram_message_id", "telegram_chat_id", "from_user_id", "reply_to_message_id"],
      "properties": {
        "record_type": {"const": "approval"},
        "id": {"type": "string", "minLength": 1},
        "champion_before": {"type": "string", "minLength": 1},
        "candidate": {"type": "string", "minLength": 1},
        "vibe_diff_sha": {"$ref": "#/$defs/sha256"},
        "decision": {"const": "approve"},
        "approved_by": {"const": "Sếp"},
        "approved_at": {"type": "string", "format": "date-time"},
        "channel": {"const": "telegram"},
        "telegram_message_id": {"type": "integer", "minimum": 1},
        "telegram_chat_id": {"type": "integer", "not": {"const": 0}},
        "from_user_id": {"type": "integer", "minimum": 1},
        "reply_to_message_id": {"type": "integer", "minimum": 1}
      }
    },
    "paired_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["both_pass", "aura_only_pass", "model_only_pass", "both_fail"],
      "properties": {
        "both_pass": {"type": "integer", "minimum": 0},
        "aura_only_pass": {"type": "integer", "minimum": 0},
        "model_only_pass": {"type": "integer", "minimum": 0},
        "both_fail": {"type": "integer", "minimum": 0}
      }
    },
    "paired_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "paired_counts"],
      "properties": {
        "batch_id": {"type": "string", "minLength": 1},
        "paired_counts": {"$ref": "#/$defs/paired_counts"}
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "champion_before", "candidate", "arena_batches", "paired_results", "exact_p", "repro_runs", "approval_id", "approved_by", "rollback_ref", "promotion_signature"],
      "properties": {
        "record_type": {"const": "promotion"},
        "champion_before": {"type": "string", "minLength": 1},
        "candidate": {"type": "string", "minLength": 1},
        "arena_batches": {"type": "array", "minItems": 2, "items": {"type": "string"}, "uniqueItems": true},
        "paired_results": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/paired_result"}},
        "exact_p": {"type": "number", "minimum": 0, "maximum": 1},
        "repro_runs": {"type": "array", "minItems": 2, "items": {"type": "string"}, "uniqueItems": true},
        "approval_id": {"type": "string", "minLength": 1},
        "approved_by": {"const": "Sếp"},
        "rollback_ref": {"type": "string", "minLength": 1},
        "promotion_signature": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
