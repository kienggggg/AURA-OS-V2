# ───────────────────────────────────────────────────────────
# AURA 2.0 — biến môi trường mẫu
# Copy file này thành `.env` rồi điền giá trị thật. KHÔNG commit `.env`.
# ───────────────────────────────────────────────────────────

# --- System 1: Local brain (Ollama, CPU-only qua core.llm.LocalCPUEngine) ---
OLLAMA_HOST=http://localhost:11434
# Model đang dùng: gemma4:e2b (NHẸ ~1.6GB) — ÉP CÂN cho máy 12GB RAM đỡ lag/đỡ swap.
# (Bản nặng cũ gemma4:e4b ~9.6GB hay làm máy đứng — đã hạ xuống e2b.)
# >>> SAU KHI ĐỔI biến này, PHẢI pull model mới:  ollama pull gemma4:e2b
OLLAMA_MODEL=gemma4:e2b
# Model nhẹ vẫn nên để timeout rộng phòng lúc nạp lần đầu / máy bận.
OLLAMA_TIMEOUT_S=1000
# XẢ RAM THẦN TỐC: thời gian giữ model trong RAM sau khi trả lời.
#   0  -> nhả NGAY toàn bộ ~9.6GB (khuyên dùng cho máy 12GB RAM).
#   5m/1h -> giữ lâu hơn (phản hồi nhanh, nhưng ăn RAM).
#   -1 -> giữ mãi (chỉ khi dư RAM).
# AURA gửi kèm MỖI request nên thắng cả default mức server.
OLLAMA_KEEP_ALIVE=0

# --- System 2: Cloud brain (Claude) ---
# Lấy tại https://console.anthropic.com/
ANTHROPIC_API_KEY=
CLOUD_MODEL=claude-sonnet-4-6

# --- System 2b: Cloud brain MIỄN PHÍ (OpenAI-compatible: Groq / Gemini / OpenRouter) ---
# Mở khoá Triad Council codegen + briefing Alpha mà KHÔNG tốn tiền. Chọn 1 nhà cung cấp:
#
#   GROQ (khuyên dùng — nhanh, free hào phóng):  https://console.groq.com/keys
#     CLOUD_PROVIDER=openai
#     OPENAI_API_KEY=gsk_...
#     OPENAI_BASE_URL=https://api.groq.com/openai/v1
#     OPENAI_MODEL=llama-3.3-70b-versatile
#
#   GEMINI (free):  https://aistudio.google.com/apikey
#     CLOUD_PROVIDER=openai
#     OPENAI_API_KEY=AIza...
#     OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     OPENAI_MODEL=gemini-2.5-flash   # (2.0-flash free hay hết quota; 2.5-flash còn quota)
#
CLOUD_PROVIDER=claude
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# Tier cho Generator của Triad Council: local | cloud | auto.
# Đặt 'cloud' SAU KHI đã cắm OPENAI_API_KEY ở trên để mở khoá codegen sạch JSON.
COUNCIL_GENERATOR_TIER=local

# --- Manga / scraping ---
# Để TRỐNG trong file mẫu. Điền giá trị thật chỉ trong .env (đã .gitignore).
GOOGLE_API_KEY=
# MANGA_PROXY=http://user:pass@host:port

# --- Memory (ChromaDB) ---
CHROMA_COLLECTION=quangia_memory
MEMORY_RECALL_K=5

# --- Daemon ---
SENSOR_INTERVAL_S=5
WS_HOST=localhost
WS_PORT=8765

# --- Vận hành ---
LOG_LEVEL=INFO

HUGGINGFACE_API_KEY=
GITHUB_API_KEY=

# --- Nhịp sinh học: Briefing sáng / Review tối ---
BRIEFING_TIME=09:59
REVIEW_TIME=21:00
BRIEFING_CATCHUP_MIN=180
# Cho briefing/review TỰ gọi Cloud (Claude) — pre-approve, không hỏi Y mỗi sáng.
BRIEFING_ALLOW_CLOUD=true
# Trần số lần gọi Cloud/ngày cho briefing (kiểm soát chi phí; 2 = sáng + tối).
BRIEFING_CLOUD_DAILY_CAP=2

# --- Connectors "Quản gia gánh việc" (CHỈ ĐỌC) ---
# Lịch: Google Calendar -> Settings -> "Secret address in iCal format" (dán URL .ics vào đây).
# ⚠️ URL này LÀ BÍ MẬT (ai có nó đọc được toàn bộ lịch) — chỉ điền giá trị thật trong .env.
CALENDAR_ICS_URL=
# Email (Gmail IMAP read-only): BẮT BUỘC dùng App Password (myaccount.google.com/apppasswords),
# KHÔNG dùng mật khẩu chính. AURA chỉ ĐỌC tiêu đề/trích lược email CHƯA ĐỌC.
GMAIL_USER=
# ⚠️ App Password LÀ BÍ MẬT — chỉ điền giá trị thật trong .env, KHÔNG để ở file mẫu này.
GMAIL_APP_PASSWORD=
IMAP_HOST=
EMAIL_UNREAD_LIMIT=7

# --- Giọng báo cáo Briefing/Review ---
# alpha  = giám sát Alpha đanh đá, mỏ hỗn (cần Cloud/Claude diễn mới tròn vai).
# gentle = quản gia hiền, máy móc (an toàn, hợp cả Local e2b).
BRIEFING_PERSONA=alpha
# Briefing sáng tự quét cơ hội việc làm (job.scout) -> Alpha thúc ra tiền.
BRIEFING_SCAN_JOBS=true
# (tuỳ chọn) ghi đè từ khoá / URL tuyển dụng; rỗng = bộ mẫu trung tính.
JOB_KEYWORDS=
JOB_URLS=

# --- Tình báo tĩnh lặng (skills/scouts/job_scout.py) ---
# Nguồn RSS hoặc trang HTML, phân tách bằng dấu phẩy. Vd RSS topcv/itviec/vlance.
# Nhánh kiếm tiền sinh tồn (Freelance & Tech)

# Bộ từ khoá để LLM chấm độ phù hợp (mặc định đã có sẵn trong code).
SCOUT_KEYWORDS=
# Ngưỡng lọc rác: bỏ tin có điểm < ngưỡng (0..1).
SCOUT_THRESHOLD=0.6

# Đã TEST SỐNG 2026-07-01 (itviec/vlance cũ đã chết — 404). python.org + RemoteOK sạch;
# job_scout tự lọc bằng LLM nên nguồn hơi rộng (RemoteOK/tuyencongchuc) vẫn ổn.
FREELANCE_URLS=
# tuyencongchuc.vn: tuyển viên chức cả nước (gồm giáo dục) — không có feed hyper-local
# hơn cho nghề/địa phương bạn đặt; SCOUT_KEYWORDS ở trên lọc ra tin liên quan.
PEDAGOGY_URLS=